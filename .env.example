# XIVIZLEY Server Architect — Environment Variables Example
# Copy this file to .env.local and configure your environment

# ── Database (PostgreSQL - Optional for local development) ─────────────────────
DATABASE_URL="postgresql://user:password@example.com:5432/dbname?pgbouncer=true&connection_limit=1"
DATABASE_URL_UNPOOLED="postgresql://user:password@example.com:5432/dbname"

# ── NextAuth.js ────────────────────────────────────────────────────────────────
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://example.com"
ADMIN_EMAIL="admin@example.com"

# ── OAuth Providers (Optional) ─────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── SMTP Email Delivery (Optional - for contact form & email exports) ──────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="user@example.com"
SMTP_PASS=""
SMTP_FROM_EMAIL="noreply@example.com"

# ── CRM & Automation Integrations (Optional) ───────────────────────────────────
SENDPULSE_API_KEY=""

# ── Cloudflare Turnstile CAPTCHA (Required in Production for Forms) ───────────
# In production, contact, newsletter and export forms require Turnstile keys.
# In local development (NODE_ENV !== 'production'), verification is bypassed if empty.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET_KEY=""

# ── Cryptographic Signing (Optional) ──────────────────────────────────────────
# NIST P-256 EC Private Key in PEM format for signing the /durum script
XIVIZLEY_SIGNING_PRIVATE_KEY=""
